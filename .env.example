# Shared services
OPENAI_API_KEY=your_openai_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
META_GRAPH_VERSION=v20.0
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# App login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_long_random_password

# ChezaHub Meta credentials
CHEZAHUB_FB_PAGE_ID=your_chezahub_facebook_page_id
CHEZAHUB_FB_PAGE_ACCESS_TOKEN=your_chezahub_page_access_token
CHEZAHUB_FB_USER_ACCESS_TOKEN=your_chezahub_user_access_token
CHEZAHUB_IG_USER_ID=your_chezahub_instagram_business_or_creator_account_id

# ChezaHub TikTok Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://smmpro.lokimax.top/api/integrations/tiktok/callback
SMMPRO_PUBLIC_URL=https://smmpro.lokimax.top
SOCIO_RETURN_ORIGINS=https://socio.jengasites.com,https://socio-beryl.vercel.app
TIKTOK_UNAUDITED_MODE=true
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# JengaSites Meta credentials
JENGASITES_FB_PAGE_ID=your_jengasites_facebook_page_id
JENGASITES_FB_PAGE_ACCESS_TOKEN=your_jengasites_page_access_token
JENGASITES_FB_USER_ACCESS_TOKEN=your_jengasites_user_access_token
JENGASITES_IG_USER_ID=your_jengasites_instagram_business_or_creator_account_id

# Required by npm run tokens:refresh.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Legacy ChezaHub fallback names still supported by the app.
NEXT_PUBLIC_FB_PAGE_ID=your_chezahub_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_chezahub_page_access_token
FB_USER_ACCESS_TOKEN=your_chezahub_user_access_token
IG_USER_ID=your_chezahub_instagram_business_or_creator_account_id

# Optional ChezaHub Telegram crosspost target
FB_ADMIN_GROUP_ID=your_facebook_group_id
