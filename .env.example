NEXT_PUBLIC_FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_USER_ACCESS_TOKEN=your_user_access_token


# Required by npm run tokens:refresh.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Optional. Filled automatically by npm run tokens:refresh when the Page has
# a connected Instagram professional account.
IG_USER_ID=your_instagram_business_or_creator_account_id

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key
